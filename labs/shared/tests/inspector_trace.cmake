if(DEFINED ORACLE)
    execute_process(COMMAND "${ORACLE}" "--test-case=${ORACLE_CASE}"
        RESULT_VARIABLE oracle_result OUTPUT_VARIABLE oracle_output ERROR_VARIABLE oracle_error)
    if(NOT oracle_result EQUAL 0)
        message(FATAL_ERROR "Snapshot check failed: ${oracle_output}${oracle_error}")
    endif()
    if(DEFINED EXPECT_SELECTOR)
        string(REGEX MATCH "TRACE_SELECTOR ([^\r\n]+)" selector "${oracle_output}")
        if(NOT selector)
            message(FATAL_ERROR "Snapshot check did not produce a selector")
        endif()
        string(REPLACE "@SELECTOR@" "${CMAKE_MATCH_1}" ARGS "${ARGS}")
    endif()
    string(REGEX MATCHALL "TRACE_RECORD [^\r\n]+" expected_records "${oracle_output}")
endif()

execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=invalid "${PROGRAM}" ${ARGS}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Inspector trace failed: ${diagnostics}")
endif()

string(REPLACE "\r\n" "\n" output "${output}")
string(STRIP "${output}" output)
string(REPLACE "\n" ";" records "${output}")
list(LENGTH records count)
if(NOT count EQUAL TICKS OR NOT output MATCHES "${EXPECTED}")
    message(FATAL_ERROR "Inspector trace missed rows or ticks")
endif()
if(DEFINED ORACLE)
    string(REPLACE "TRACE_RECORD " "" expected_records "${expected_records}")
    if(NOT records STREQUAL expected_records)
        message(FATAL_ERROR "CLI records differ from the sampled snapshots")
    endif()
endif()
if(DEFINED FIRST_EXPECTED)
    list(GET records 0 first)
    if(NOT first MATCHES "${FIRST_EXPECTED}")
        message(FATAL_ERROR "Unexpected first inspector record: ${first}")
    endif()
endif()

if(DEFINED EQUIVALENT_ARGS)
    execute_process(COMMAND "${PROGRAM}" ${EQUIVALENT_ARGS}
        RESULT_VARIABLE equivalent_result OUTPUT_VARIABLE equivalent ERROR_VARIABLE equivalent_error)
    string(REPLACE "\r\n" "\n" equivalent "${equivalent}")
    string(STRIP "${equivalent}" equivalent)
    if(NOT equivalent_result EQUAL 0 OR NOT equivalent STREQUAL output)
        message(FATAL_ERROR "The other agent selector produced different records: ${equivalent_error}")
    endif()
endif()
if(DEFINED NORMAL_ARGS)
    execute_process(COMMAND "${PROGRAM}" ${NORMAL_ARGS}
        RESULT_VARIABLE normal_result OUTPUT_VARIABLE normal)
    if(NOT normal_result EQUAL 0 OR NOT normal MATCHES "3 ticks, [0-9]+ completed products, [0-9]+ ticks/s")
        message(FATAL_ERROR "Ordinary i4sim batch output failed: ${normal}")
    endif()
    execute_process(COMMAND "${PROGRAM}" ${NORMAL_ARGS} --inspect absent
        RESULT_VARIABLE unknown_result OUTPUT_VARIABLE unknown ERROR_VARIABLE unknown_error)
    if(NOT unknown_result EQUAL 1 OR unknown OR NOT unknown_error MATCHES "Unknown mover ID")
        message(FATAL_ERROR "Unknown mover did not fail cleanly: ${unknown}${unknown_error}")
    endif()
endif()

set(tick 0)
foreach(record IN LISTS records)
    math(EXPR tick "${tick} + 1")
    if(NOT record MATCHES "^\\{.*\"groups\":.*\"id\":.*\"tick\":${tick}\\}$")
        message(FATAL_ERROR "Invalid inspector record for tick ${tick}: ${record}")
    endif()
    if(ALL_ABSENT AND NOT record MATCHES "\"groups\":null")
        message(FATAL_ERROR "An absent agent had rows at tick ${tick}: ${record}")
    endif()
endforeach()
