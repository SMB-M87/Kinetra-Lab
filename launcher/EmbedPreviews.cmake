# The capture script writes top-down RGBA bytes. Embed them so the launcher has no
# image decoder or asset lookup at runtime.
set(width 320)
set(height 180)
math(EXPR row_bytes "${width} * 4")
math(EXPR image_bytes "${row_bytes} * ${height}")
math(EXPR row_hex_chars "${row_bytes} * 2")
math(EXPR last_row "${height} - 1")
set(header "#pragma once\n#include <cstdint>\n\nnamespace launcher::detail {\n")
string(APPEND header "inline constexpr int preview_width = ${width}, preview_height = ${height};\n")
foreach(lab IN ITEMS demo dotio i4sim)
    set(file "${input_dir}/${lab}.rgba")
    file(SIZE "${file}" size)
    if(NOT size EQUAL image_bytes)
        message(FATAL_ERROR "${file} must contain ${width}x${height} RGBA pixels")
    endif()
    file(READ "${file}" pixels HEX)
    string(APPEND header "inline constexpr std::uint8_t ${lab}_preview[] = {\n")
    foreach(row RANGE ${last_row})
        math(EXPR offset "${row} * ${row_hex_chars}")
        string(SUBSTRING "${pixels}" ${offset} ${row_hex_chars} line)
        string(REGEX REPLACE "(..)" "0x\\1," bytes "${line}")
        string(APPEND header "${bytes}\n")
    endforeach()
    string(APPEND header "};\n")
endforeach()
string(APPEND header "} // namespace launcher::detail\n")
file(WRITE "${output}" "${header}")
